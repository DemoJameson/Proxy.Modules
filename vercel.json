{
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                { "key": "X-Content-Type-Options", "value": "nosniff" },
                { "key": "Referrer-Policy", "value": "no-referrer" },
                { "key": "X-Frame-Options", "value": "DENY" },
                {
                    "key": "Content-Security-Policy",
                    "value": "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self'; connect-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'"
                },
                { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
                { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" }
            ]
        },
        {
            "source": "/admin",
            "headers": [{ "key": "Cache-Control", "value": "no-store" }]
        },
        {
            "source": "/admin/",
            "headers": [{ "key": "Cache-Control", "value": "no-store" }]
        },
        {
            "source": "/admin.html",
            "headers": [{ "key": "Cache-Control", "value": "no-store" }]
        }
    ],
    "rewrites": [
        {
            "source": "/admin",
            "destination": "/admin.html"
        },
        {
            "source": "/admin/",
            "destination": "/admin.html"
        }
    ],
    "functions": {
        "api/redirect.js": {
            "maxDuration": 10
        },
        "api/trakt/translations.js": {
            "maxDuration": 30
        },
        "api/trakt/images.js": {
            "maxDuration": 30
        },
        "api/trakt/credits.js": {
            "maxDuration": 30
        },
        "api/trakt/people-names.js": {
            "maxDuration": 30
        },
        "api/trakt/comment-translations.js": {
            "maxDuration": 30
        },
        "api/trakt/list-translations.js": {
            "maxDuration": 30
        },
        "api/trakt/apikeys.js": {
            "maxDuration": 10
        }
    },
    "git": {
        "deploymentEnabled": {
            "*": false,
            "**": false,
            "main": true
        }
    },
    "ignoreCommand": "node scripts/vercel-ignore-build.mjs",
    "proxy": {
        "entrypoint": "middleware.js",
        "matcher": [
            "/api/trakt/translations",
            "/api/trakt/images",
            "/api/trakt/credits",
            "/api/trakt/people-names",
            "/api/trakt/comment-translations",
            "/api/trakt/list-translations",
            "/api/trakt/translation-overrides",
            "/api/trakt/apikeys"
        ]
    }
}
