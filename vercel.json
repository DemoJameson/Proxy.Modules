{
    "rewrites": [
        {
            "source": "/admin",
            "destination": "/admin.html"
        },
        {
            "source": "/admin/",
            "destination": "/admin.html"
        }
    ],
    "functions": {
        "api/redirect.js": {
            "maxDuration": 10
        },
        "api/trakt/translations.js": {
            "maxDuration": 30
        },
        "api/trakt/images.js": {
            "maxDuration": 30
        },
        "api/trakt/credits.js": {
            "maxDuration": 30
        },
        "api/trakt/people-names.js": {
            "maxDuration": 30
        },
        "api/trakt/comment-translations.js": {
            "maxDuration": 30
        },
        "api/trakt/list-translations.js": {
            "maxDuration": 30
        },
        "api/trakt/apikeys.js": {
            "maxDuration": 10
        }
    },
    "git": {
        "deploymentEnabled": {
            "*": false,
            "**": false,
            "main": true
        }
    },
    "ignoreCommand": "node scripts/vercel-ignore-build.mjs",
    "proxy": {
        "entrypoint": "middleware.js",
        "matcher": [
            "/api/trakt/translations",
            "/api/trakt/images",
            "/api/trakt/credits",
            "/api/trakt/people-names",
            "/api/trakt/comment-translations",
            "/api/trakt/list-translations",
            "/api/trakt/translation-overrides",
            "/api/trakt/apikeys"
        ]
    }
}
