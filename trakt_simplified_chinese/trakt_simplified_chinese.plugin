#!name=Trakt 增强
#!desc=Trakt App 各页面从英文改为简体中文或港台繁体，包括海报；历史页面剧集类别的已观看记录按电视剧合并；Trakt 的影片详情页添加 Forward、Infuse、Rex 跳转按钮；部分兼容其它使用了 Trakt API 的应用。
#!icon=https://raw.githubusercontent.com/DemoJameson/Proxy.Modules/main/trakt_simplified_chinese/images/trakt.webp
#!homepage=https://github.com/DemoJameson/Proxy.Modules
#!openUrl=https://apps.apple.com/app/id1514873602
#!author=DemoJameson
#!updatedTime=2026-10-22 02:32:52

[Argument]
fakeVipEnabled = switch, "true", tag=伪装成 VIP, desc=启用后伪装为 Trakt VIP 会员，移除 App 中的广告
chineseLocale = select,"简体中文","繁體中文（台灣）","繁體中文（香港）",tag=目标语言,desc=选择目标语言：简体中文、繁體中文（台灣）或繁體中文（香港）
posterImageMode = select,"原片语言","简体中文","繁體中文（台灣）","繁體中文（香港）","原图",tag=海报语言,desc=原片语言使用 TMDb 影片原始语言图片；中文按所选语言优先匹配海报；原图保留 Trakt 原图
translationEngine = select,"谷歌翻译","DeepLX","关闭",tag=翻译部分文本,desc=选择翻译引擎：谷歌翻译（快，需翻墙）、DeepLX（慢，可直连）、关闭
characterTranslationEnabled = switch, "true", tag=用豆瓣翻译角色名, desc=启用后会用豆瓣翻译角色名
historyEpisodesMergedByShow = switch, "true", tag=历史剧集按电视剧合并, desc=启用后会将历史页面电视剧类别的观看记录按电视剧合并
forwardButtonOrder = select,"1","2","3","0",tag=Forward 跳转按钮,desc=序号代表在 Trakt 中的排序位置，0 不显示，默认 1
infuseButtonOrder = select,"1","2","3","0",tag=Infuse 跳转按钮,desc=序号代表在 Trakt 中的排序位置，0 不显示，默认 2
rexButtonOrder = select,"1","2","3","0",tag=Rex 跳转按钮,desc=序号代表在 Trakt 中的排序位置，0 不显示，默认 3
backendBaseUrl = input, "https://proxy-modules.demojameson.de5.net", tag=翻译缓存接口, desc=用于批量获取 Trakt 的中文翻译，一般留空即可
tamperAppAuthorizationEnabled = switch, "false", tag=篡改应用授权, desc=启用后将第三方 App 的 Trakt 授权篡改成 Trakt 官方 App，规避应用连接数的限制，请仅在需要时开启
debugMode = select,"关闭","禁用本地缓存","禁用远端缓存","禁用所有缓存",tag=调试模式,desc=禁用本地缓存：不读写持久化存储；禁用远端缓存：不请求后端缓存接口；禁用所有缓存：两者皆禁用

[Script]
# 篡改第三方 App 的 Trakt OAuth 设备码和 token 请求
request if ${url} ~= /^https:\/\/apiz?\.trakt\.tv\/oauth\/(?:device\/code|device\/token|token)(?:\?.*)?$/i then script("https://raw.githubusercontent.com/DemoJameson/Proxy.Modules/main/trakt_simplified_chinese/trakt_simplified_chinese.js", {${fakeVipEnabled}, ${chineseLocale}, ${posterImageMode}, ${translationEngine}, ${characterTranslationEnabled}, ${historyEpisodesMergedByShow}, ${forwardButtonOrder}, ${infuseButtonOrder}, ${rexButtonOrder}, ${backendBaseUrl}, ${tamperAppAuthorizationEnabled}, ${debugMode}}) with tag="Trakt OAuth Client Rewrite", timeout=10, requires_body=true
# 篡改第三方 App 的 Trakt Auth token 请求
request if ${url} ~= /^https:\/\/auth\.trakt\.tv\/oauth\/token(?:\?.*)?$/i then script("https://raw.githubusercontent.com/DemoJameson/Proxy.Modules/main/trakt_simplified_chinese/trakt_simplified_chinese.js", {${fakeVipEnabled}, ${chineseLocale}, ${posterImageMode}, ${translationEngine}, ${characterTranslationEnabled}, ${historyEpisodesMergedByShow}, ${forwardButtonOrder}, ${infuseButtonOrder}, ${rexButtonOrder}, ${backendBaseUrl}, ${tamperAppAuthorizationEnabled}, ${debugMode}}) with tag="Trakt Auth OAuth Client Rewrite", timeout=10, requires_body=true
# 篡改第三方 App 的 trakt.tv token 请求
request if ${url} ~= /^https:\/\/trakt\.tv\/oauth\/token(?:\?.*)?$/i then script("https://raw.githubusercontent.com/DemoJameson/Proxy.Modules/main/trakt_simplified_chinese/trakt_simplified_chinese.js", {${fakeVipEnabled}, ${chineseLocale}, ${posterImageMode}, ${translationEngine}, ${characterTranslationEnabled}, ${historyEpisodesMergedByShow}, ${forwardButtonOrder}, ${infuseButtonOrder}, ${rexButtonOrder}, ${backendBaseUrl}, ${tamperAppAuthorizationEnabled}, ${debugMode}}) with tag="Trakt Web OAuth Client Rewrite", timeout=10, requires_body=true
# 替换第三方 App 的 trakt.tv 授权地址
request if ${url} ~= /^https:\/\/trakt\.tv\/oauth\/authorize(?:\?.*)?$/i then script("https://raw.githubusercontent.com/DemoJameson/Proxy.Modules/main/trakt_simplified_chinese/trakt_simplified_chinese.js", {${fakeVipEnabled}, ${chineseLocale}, ${posterImageMode}, ${translationEngine}, ${characterTranslationEnabled}, ${historyEpisodesMergedByShow}, ${forwardButtonOrder}, ${infuseButtonOrder}, ${rexButtonOrder}, ${backendBaseUrl}, ${tamperAppAuthorizationEnabled}, ${debugMode}}) with tag="Trakt Web OAuth Authorize Rewrite", timeout=10
# 替换第三方 App 的 auth.trakt.tv 授权地址
request if ${url} ~= /^https:\/\/auth\.trakt\.tv\/oauth\/authorize(?:\?.*)?$/i then script("https://raw.githubusercontent.com/DemoJameson/Proxy.Modules/main/trakt_simplified_chinese/trakt_simplified_chinese.js", {${fakeVipEnabled}, ${chineseLocale}, ${posterImageMode}, ${translationEngine}, ${characterTranslationEnabled}, ${historyEpisodesMergedByShow}, ${forwardButtonOrder}, ${infuseButtonOrder}, ${rexButtonOrder}, ${backendBaseUrl}, ${tamperAppAuthorizationEnabled}, ${debugMode}}) with tag="Trakt Auth OAuth Authorize Rewrite", timeout=10
# 将 Trakt 官方授权回调还原为第三方 App 回调
response if ${url} ~= /^https:\/\/auth\.trakt\.tv\/api\/auth\/oauth2\/authorize(?:\?.*)?$/i then script("https://raw.githubusercontent.com/DemoJameson/Proxy.Modules/main/trakt_simplified_chinese/trakt_simplified_chinese.js", {${fakeVipEnabled}, ${chineseLocale}, ${posterImageMode}, ${translationEngine}, ${characterTranslationEnabled}, ${historyEpisodesMergedByShow}, ${forwardButtonOrder}, ${infuseButtonOrder}, ${rexButtonOrder}, ${backendBaseUrl}, ${tamperAppAuthorizationEnabled}, ${debugMode}}) with tag="Trakt OAuth Callback Rewrite", timeout=10
# 将 trakt.tv 官方授权回调还原为第三方 App 回调
response if ${url} ~= /^https:\/\/trakt\.tv\/api\/auth\/oauth2\/authorize(?:\?.*)?$/i then script("https://raw.githubusercontent.com/DemoJameson/Proxy.Modules/main/trakt_simplified_chinese/trakt_simplified_chinese.js", {${fakeVipEnabled}, ${chineseLocale}, ${posterImageMode}, ${translationEngine}, ${characterTranslationEnabled}, ${historyEpisodesMergedByShow}, ${forwardButtonOrder}, ${infuseButtonOrder}, ${rexButtonOrder}, ${backendBaseUrl}, ${tamperAppAuthorizationEnabled}, ${debugMode}}) with tag="Trakt Web OAuth Callback Rewrite", timeout=10
# 记录篡改流程签发的 Trakt Auth access/refresh token
response if ${url} ~= /^https:\/\/auth\.trakt\.tv\/oauth\/token(?:\?.*)?$/i then script("https://raw.githubusercontent.com/DemoJameson/Proxy.Modules/main/trakt_simplified_chinese/trakt_simplified_chinese.js", {${fakeVipEnabled}, ${chineseLocale}, ${posterImageMode}, ${translationEngine}, ${characterTranslationEnabled}, ${historyEpisodesMergedByShow}, ${forwardButtonOrder}, ${infuseButtonOrder}, ${rexButtonOrder}, ${backendBaseUrl}, ${tamperAppAuthorizationEnabled}, ${debugMode}}) with tag="Trakt Auth OAuth Token Response Rewrite", timeout=10, requires_body=true
# 记录篡改流程签发的 trakt.tv access/refresh token
response if ${url} ~= /^https:\/\/trakt\.tv\/oauth\/token(?:\?.*)?$/i then script("https://raw.githubusercontent.com/DemoJameson/Proxy.Modules/main/trakt_simplified_chinese/trakt_simplified_chinese.js", {${fakeVipEnabled}, ${chineseLocale}, ${posterImageMode}, ${translationEngine}, ${characterTranslationEnabled}, ${historyEpisodesMergedByShow}, ${forwardButtonOrder}, ${infuseButtonOrder}, ${rexButtonOrder}, ${backendBaseUrl}, ${tamperAppAuthorizationEnabled}, ${debugMode}}) with tag="Trakt Web OAuth Token Response Rewrite", timeout=10, requires_body=true
# 处理播放器 DeepLink 跳转
request if ${url} ~= /^https:\/\/loon-plugins\.demojameson\.de5\.net\/api\/redirect\?.*$/i then script("https://raw.githubusercontent.com/DemoJameson/Proxy.Modules/main/trakt_simplified_chinese/trakt_simplified_chinese.js", {${fakeVipEnabled}, ${chineseLocale}, ${posterImageMode}, ${translationEngine}, ${characterTranslationEnabled}, ${historyEpisodesMergedByShow}, ${forwardButtonOrder}, ${infuseButtonOrder}, ${rexButtonOrder}, ${backendBaseUrl}, ${tamperAppAuthorizationEnabled}, ${debugMode}}) with tag="Direct Redirect", timeout=10
# SofaTime 中自定义播放器 Logo
request if ${url} ~= /^https:\/\/image\.tmdb\.org\/t\/p\/w342\/[a-z0-9_-]+_logo\.webp(?:\?.*)?$/i then script("https://raw.githubusercontent.com/DemoJameson/Proxy.Modules/main/trakt_simplified_chinese/trakt_simplified_chinese.js", {${fakeVipEnabled}, ${chineseLocale}, ${posterImageMode}, ${translationEngine}, ${characterTranslationEnabled}, ${historyEpisodesMergedByShow}, ${forwardButtonOrder}, ${infuseButtonOrder}, ${rexButtonOrder}, ${backendBaseUrl}, ${tamperAppAuthorizationEnabled}, ${debugMode}}) with tag="TMDB Logo Redirect", timeout=10
# 拦截 sync/history/episodes 请求，放大 limit
request if ${url} ~= /^https:\/\/apiz?\.trakt\.tv\/sync\/history\/episodes\/?(\?.*)?$/i then script("https://raw.githubusercontent.com/DemoJameson/Proxy.Modules/main/trakt_simplified_chinese/trakt_simplified_chinese.js", {${fakeVipEnabled}, ${chineseLocale}, ${posterImageMode}, ${translationEngine}, ${characterTranslationEnabled}, ${historyEpisodesMergedByShow}, ${forwardButtonOrder}, ${infuseButtonOrder}, ${rexButtonOrder}, ${backendBaseUrl}, ${tamperAppAuthorizationEnabled}, ${debugMode}}) with tag="Trakt Sync History Episodes Request", timeout=10
# 拦截 history/episodes 请求，放大 limit
request if ${url} ~= /^https:\/\/apiz?\.trakt\.tv\/users\/[^\/]+?\/history\/episodes\/?(\?.*)?$/i then script("https://raw.githubusercontent.com/DemoJameson/Proxy.Modules/main/trakt_simplified_chinese/trakt_simplified_chinese.js", {${fakeVipEnabled}, ${chineseLocale}, ${posterImageMode}, ${translationEngine}, ${characterTranslationEnabled}, ${historyEpisodesMergedByShow}, ${forwardButtonOrder}, ${infuseButtonOrder}, ${rexButtonOrder}, ${backendBaseUrl}, ${tamperAppAuthorizationEnabled}, ${debugMode}}) with tag="Trakt History Episodes Request", timeout=10
# 拦截带季号的请求，记录当前浏览季
request if ${url} ~= /^https:\/\/apiz?\.trakt\.tv\/shows\/[^\/]+\/seasons\/\d+(?:\/.*|\?.*)?$/i then script("https://raw.githubusercontent.com/DemoJameson/Proxy.Modules/main/trakt_simplified_chinese/trakt_simplified_chinese.js", {${fakeVipEnabled}, ${chineseLocale}, ${posterImageMode}, ${translationEngine}, ${characterTranslationEnabled}, ${historyEpisodesMergedByShow}, ${forwardButtonOrder}, ${infuseButtonOrder}, ${rexButtonOrder}, ${backendBaseUrl}, ${tamperAppAuthorizationEnabled}, ${debugMode}}) with tag="Trakt Current Season Request", timeout=10
# 按篡改流程签发的 access token 改写 trakt-api-key
request if ${url} ~= /^https:\/\/apiz?\.trakt\.tv\/(?!oauth\/).*$/i then script("https://raw.githubusercontent.com/DemoJameson/Proxy.Modules/main/trakt_simplified_chinese/trakt_simplified_chinese.js", {${fakeVipEnabled}, ${chineseLocale}, ${posterImageMode}, ${translationEngine}, ${characterTranslationEnabled}, ${historyEpisodesMergedByShow}, ${forwardButtonOrder}, ${infuseButtonOrder}, ${rexButtonOrder}, ${backendBaseUrl}, ${tamperAppAuthorizationEnabled}, ${debugMode}}) with tag="Trakt API Key Rewrite", timeout=10
# 统一拦截 Trakt 响应，由脚本内部分流处理
response if ${url} ~= /^https:\/\/apiz?\.trakt\.tv\/.*$/i then script("https://raw.githubusercontent.com/DemoJameson/Proxy.Modules/main/trakt_simplified_chinese/trakt_simplified_chinese.js", {${fakeVipEnabled}, ${chineseLocale}, ${posterImageMode}, ${translationEngine}, ${characterTranslationEnabled}, ${historyEpisodesMergedByShow}, ${forwardButtonOrder}, ${infuseButtonOrder}, ${rexButtonOrder}, ${backendBaseUrl}, ${tamperAppAuthorizationEnabled}, ${debugMode}}) with tag="Trakt Response Router", timeout=60, requires_body=true
# 仅拦截 SofaTime 的 TMDB provider 列表，注入播放器
response if ${url} ~= /^https:\/\/api\.themoviedb\.org\/3\/watch\/providers\/(?:movie|tv)(\?.*)?$/i then script("https://raw.githubusercontent.com/DemoJameson/Proxy.Modules/main/trakt_simplified_chinese/trakt_simplified_chinese.js", {${fakeVipEnabled}, ${chineseLocale}, ${posterImageMode}, ${translationEngine}, ${characterTranslationEnabled}, ${historyEpisodesMergedByShow}, ${forwardButtonOrder}, ${infuseButtonOrder}, ${rexButtonOrder}, ${backendBaseUrl}, ${tamperAppAuthorizationEnabled}, ${debugMode}}) with tag="TMDB Provider Catalog", timeout=60, requires_body=true
# 仅拦截 SofaTime 的 TMDB 详情请求（append_to_response 含 watch/providers），清除原有观看来源并注入排序 1 播放器
response if ${url} ~= /^https:\/\/api\.themoviedb\.org\/3\/(?:tv|movie)\/\d+\?.*watch(?:%2F|\/)providers.*$/i then script("https://raw.githubusercontent.com/DemoJameson/Proxy.Modules/main/trakt_simplified_chinese/trakt_simplified_chinese.js", {${fakeVipEnabled}, ${chineseLocale}, ${posterImageMode}, ${translationEngine}, ${characterTranslationEnabled}, ${historyEpisodesMergedByShow}, ${forwardButtonOrder}, ${infuseButtonOrder}, ${rexButtonOrder}, ${backendBaseUrl}, ${tamperAppAuthorizationEnabled}, ${debugMode}}) with tag="TMDB Detail Watch Providers", timeout=60, requires_body=true

[MITM]
hostname = apiz.trakt.tv, api.trakt.tv, auth.trakt.tv, trakt.tv, api.themoviedb.org, image.tmdb.org, loon-plugins.demojameson.de5.net
